require('dotenv').config();
const axios = require("axios");
const { delay } = require('./utils');

// Configuration
const CONFIG = {
  PAGE_ID: process.env.PAGE_ID || '61569568475776',
  AUTHORIZED_USERS: new Set((process.env.AUTHORIZED_USERS || '61565963713938').split(',')),
  API_VERSION: 'v21.0',
  MESSAGE_DELAY: 1000, // 1 seconde entre les messages
  MAX_RETRIES: 3
};

// Cache pour éviter les doublons
let processedPSIDs = new Set();

async function getAllPSIDs(pageAccessToken) {
  try {
    let psids = [];
    let nextPage = `https://graph.facebook.com/${CONFIG.API_VERSION}/${CONFIG.PAGE_ID}/conversations?fields=participants&access_token=${pageAccessToken}`;
    
    while (nextPage) {
      const response = await axios.get(nextPage, {
        timeout: 10000
      });

      const { data, paging } = response.data;

      for (const convo of data) {
        for (const participant of convo.participants.data) {
          if (participant.id !== CONFIG.PAGE_ID && 
              !CONFIG.AUTHORIZED_USERS.has(participant.id) &&
              !processedPSIDs.has(participant.id)) {
            psids.push(participant.id);
            processedPSIDs.add(participant.id);
          }
        }
      }

      nextPage = paging?.next || null;
      await delay(500); // Pause anti-rate limit
    }

    return psids;
  } catch (error) {
    console.error('Erreur getAllPSIDs:', error.response?.data || error.message);
    return [];
  }
}

async function sendNotification(psid, message, pageAccessToken, retryCount = 0) {
  try {
    await axios.post(`https://graph.facebook.com/${CONFIG.API_VERSION}/me/messages`, {
      recipient: { id: psid },
      message: { text: message },
    }, {
      params: { access_token: pageAccessToken },
      timeout: 5000
    });
    return true;
  } catch (error) {
    if (retryCount < CONFIG.MAX_RETRIES) {
      await delay(2000);
      return sendNotification(psid, message, pageAccessToken, retryCount + 1);
    }
    console.error(`Échec envoi à ${psid}:`, error.response?.data || error.message);
    return false;
  }
}

async function sendBulkNotifications(message, pageAccessToken) {
  const users = await getAllPSIDs(pageAccessToken);
  const results = { success: 0, failed: 0 };

  for (const [index, psid] of users.entries()) {
    const success = await sendNotification(psid, message, pageAccessToken);
    success ? results.success++ : results.failed++;
    
    if (index < users.length - 1) {
      await delay(CONFIG.MESSAGE_DELAY);
    }
  }

  return results;
}

module.exports = {
  name: 'sendnoti',
  description: 'Envoie une notification à tous les utilisateurs',
  author: 'Cliff',
  usage: "sendnoti <message>",
  async execute(senderId, args, pageAccessToken, sendMessage) {

    // Vérification des permissions
    if (!CONFIG.AUTHORIZED_USERS.has(senderId)) {
      return sendMessage(senderId, { 
        text: "⚠️ Commande réservée aux administrateurs." 
      }, pageAccessToken);
    }

    // Validation du message
    const message = args.join(' ').trim();
    if (!message) {
      return sendMessage(senderId, { 
        text: "❌ Veuillez fournir un message à envoyer.\nExemple: sendnoti Bonjour à tous !" 
      }, pageAccessToken);
    }

    try {
      // Début du processus
      await sendMessage(senderId, { 
        text: "🔄 Début de l'envoi des notifications..." 
      }, pageAccessToken);

      // Envoi en masse
      const { success, failed } = await sendBulkNotifications(message, pageAccessToken);

      // Rapport final
      await sendMessage(senderId, {
        text: `✅ Envoi terminé !\nSuccès: ${success}\nÉchecs: ${failed}`
      }, pageAccessToken);

    } catch (error) {
      console.error('Erreur execute:', error);
      await sendMessage(senderId, { 
        text: `❌ Erreur critique: ${error.message}` 
      }, pageAccessToken);
    }
  }
};
